{
  "expo": {
    "name": "sobre-carros",
    "slug": "sobre-carros",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logoappcarro4.png",
    "scheme": "sobrecarros",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/logoappcarro4.png",
        "backgroundImage": "./assets/images/logoappcarro4.png",
        "monochromeImage": "./assets/images/logoappcarro4.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.anals.sobrecarros"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/logoappcarro4.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/logoappcarro3.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "280f868f-fc4b-410a-87ac-ab0ab3a68f42"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/280f868f-fc4b-410a-87ac-ab0ab3a68f42"
    }
  }
}
